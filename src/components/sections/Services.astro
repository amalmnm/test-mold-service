---
const services = [
  {
    title: "Mold Inspection",
    description: "Professional inspections to identify mold and moisture issues.",
    icon: "🔍",
  },
  {
    title: "Mold Testing",
    description: "Laboratory testing to determine mold type and severity.",
    icon: "🧪",
  },
  {
    title: "Mold Remediation",
    description: "Safe and effective mold removal for residential and commercial properties.",
    icon: "🛠️",
  },
  {
    title: "Water Damage",
    description: "Moisture control and restoration to prevent mold growth.",
    icon: "💧",
  },
];
---

<section class="py-20 bg-gray-50">
  <div class="mx-auto max-w-7xl px-6">
    <div class="text-center mb-12">
      <p class="text-blue-600 font-semibold uppercase">Our Services</p>
      <h2 class="mt-3 text-4xl font-bold">
        Complete Mold Solutions
      </h2>
      <p class="mt-4 text-gray-600">
        Professional inspection, testing and remediation services.
      </p>
    </div>

    <div class="grid gap-8 md:grid-cols-2 lg:grid-cols-4">
      {services.map((service) => (
        <div class="rounded-xl bg-white p-8 shadow transition hover:-translate-y-2 hover:shadow-lg">
          <div class="mb-5 text-5xl">{service.icon}</div>

          <h3 class="mb-3 text-xl font-semibold">
            {service.title}
          </h3>

          <p class="text-gray-600">
            {service.description}
          </p>
        </div>
      ))}
    </div>
  </div>
</section>