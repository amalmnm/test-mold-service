---
---

<section id="contact" class="bg-white py-20">
  <div class="mx-auto max-w-7xl px-6">
    <!-- Heading -->
    <div class="mx-auto mb-14 max-w-3xl text-center">
      <span class="rounded-full bg-green-100 px-4 py-1 text-sm font-semibold text-green-700">
        Contact Us
      </span>

      <h2 class="mt-4 text-4xl font-bold text-gray-900">
        Need Mold Removal? Contact Our Experts Today
      </h2>

      <p class="mt-4 text-lg text-gray-600">
        Whether you need emergency mold remediation, mold testing, or a free
        consultation, our team is ready to help. Fill out the form below and
        we'll get back to you as soon as possible.
      </p>
    </div>

    <div class="grid gap-12 lg:grid-cols-2">
      <!-- Contact Info -->
      <div class="space-y-8">
        <div class="rounded-2xl bg-green-50 p-6">
          <h3 class="mb-6 text-2xl font-bold text-gray-900">
            Contact Information
          </h3>

          <div class="space-y-5">
            <div>
              <p class="font-semibold text-gray-900">📞 Phone</p>
              <p class="text-gray-600">(555) 123-4567</p>
            </div>

            <div>
              <p class="font-semibold text-gray-900">✉️ Email</p>
              <p class="text-gray-600">info@moldservice.com</p>
            </div>

            <div>
              <p class="font-semibold text-gray-900">📍 Office</p>
              <p class="text-gray-600">
                123 Main Street<br />
                Your City, State 12345
              </p>
            </div>

            <div>
              <p class="font-semibold text-gray-900">🕒 Working Hours</p>
              <p class="text-gray-600">
                Monday – Friday: 8:00 AM – 6:00 PM<br />
                24/7 Emergency Services Available
              </p>
            </div>
          </div>
        </div>
      </div>

      <!-- Contact Form -->
      <form class="space-y-6 rounded-2xl bg-gray-50 p-8 shadow">
        <div class="grid gap-6 md:grid-cols-2">
          <input
            type="text"
            placeholder="Full Name"
            class="rounded-lg border border-gray-300 px-4 py-3 outline-none focus:border-green-600"
          />

          <input
            type="email"
            placeholder="Email Address"
            class="rounded-lg border border-gray-300 px-4 py-3 outline-none focus:border-green-600"
          />
        </div>

        <input
          type="tel"
          placeholder="Phone Number"
          class="w-full rounded-lg border border-gray-300 px-4 py-3 outline-none focus:border-green-600"
        />

        <input
          type="text"
          placeholder="Service Needed"
          class="w-full rounded-lg border border-gray-300 px-4 py-3 outline-none focus:border-green-600"
        />

        <textarea
          rows="6"
          placeholder="Tell us about your mold issue..."
          class="w-full rounded-lg border border-gray-300 px-4 py-3 outline-none focus:border-green-600"
        ></textarea>

        <button
          class="w-full rounded-lg bg-green-700 py-4 font-semibold text-white transition hover:bg-green-800"
        >
          Send Message
        </button>
      </form>
    </div>
  </div>
</section>