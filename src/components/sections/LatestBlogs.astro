---
const blogs = [
  {
    image: "/images/blog-1.png",
    category: "Mold Removal",
    title: "Signs You May Have Hidden Mold in Your Home",
    excerpt:
      "Learn the most common warning signs of hidden mold and when it's time to schedule a professional inspection.",
    date: "July 24, 2026",
    link: "#",
  },
  {
    image: "/images/blog-2.png",
    category: "Mold Testing",
    title: "Why Professional Mold Testing Matters",
    excerpt:
      "Discover how certified mold testing helps identify hidden issues before they become costly problems.",
    date: "July 20, 2026",
    link: "#",
  },
  {
    image: "/images/blog-3.png",
    category: "Indoor Air Quality",
    title: "Preventing Mold Growth After Water Damage",
    excerpt:
      "Follow these essential steps to keep mold from developing after leaks, flooding, or moisture problems.",
    date: "July 15, 2026",
    link: "#",
  },
];
---

<section class="bg-gray-50 py-20">
  <div class="mx-auto max-w-7xl px-6">
    <!-- Heading -->
    <div class="mx-auto mb-14 max-w-3xl text-center">
      <span
        class="inline-block rounded-full bg-green-100 px-4 py-1 text-sm font-semibold text-green-700"
      >
        Latest Blogs
      </span>

      <h2 class="mt-4 text-4xl font-bold text-gray-900">
        Expert Tips & Mold Prevention Insights
      </h2>

      <p class="mt-4 text-lg text-gray-600">
        Stay informed with expert advice on mold testing, mold removal, indoor
        air quality, and moisture prevention.
      </p>
    </div>

    <!-- Blog Grid -->
    <div class="grid gap-8 md:grid-cols-2 lg:grid-cols-3">
      {
        blogs.map((blog) => (
          <article
            class="overflow-hidden rounded-2xl bg-white shadow transition duration-300 hover:-translate-y-2 hover:shadow-xl"
          >
            <div class="overflow-hidden">
              <img
                src={blog.image}
                alt={blog.title}
                class="h-60 w-full object-cover transition duration-500 hover:scale-105"
              />
            </div>

            <div class="p-6">
              <span
                class="rounded-full bg-green-100 px-3 py-1 text-xs font-semibold text-green-700"
              >
                {blog.category}
              </span>

              <h3 class="mt-4 text-xl font-bold text-gray-900">
                {blog.title}
              </h3>

              <p class="mt-3 text-gray-600">
                {blog.excerpt}
              </p>

              <div
                class="mt-6 flex items-center justify-between border-t pt-4"
              >
                <span class="text-sm text-gray-500">{blog.date}</span>

                <a
                  href={blog.link}
                  class="font-semibold text-green-700 transition hover:text-green-900"
                >
                  Read More →
                </a>
              </div>
            </div>
          </article>
        ))
      }
    </div>

    <!-- CTA -->
    <div class="mt-14 text-center">
      <a
        href="/blog"
        class="inline-flex items-center rounded-lg bg-green-700 px-8 py-3 font-semibold text-white transition hover:bg-green-800"
      >
        View All Blogs
      </a>
    </div>
  </div>
</section>