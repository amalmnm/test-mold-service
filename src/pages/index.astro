---
import MainLayout from "../layouts/MainLayout.astro";

import Hero from "../components/sections/Hero.astro";
import Services from "../components/sections/Services.astro";
import About from "../components/sections/About.astro";
import WhyChoose from "../components/sections/WhyChoose.astro";
import Process from "../components/sections/Process.astro";
import Stats from "../components/sections/Stats.astro";
import Testimonials from "../components/sections/Testimonials.astro";
import LatestBlogs from "../components/sections/LatestBlogs.astro";
import ContactUs from "../components/sections/ContactUs.astro";

import { getEntry } from "astro:content";

const home = await getEntry("pages", "home");

if (!home) {
  throw new Error("home.md not found");
}
---

<MainLayout title="Test Mold Service">

  <Hero 
    title={home.data.heroTitle}
    description={home.data.heroText}
  />

  <Services />
  <About />
  <WhyChoose />
  <Process />
  <Stats />
  <Testimonials />
  <LatestBlogs />
  <ContactUs />

</MainLayout>